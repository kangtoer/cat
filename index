    function computeCpMasteryBreakdown(sub, pkg) {
      return BSKAP_CP_ELEMENTS.map((name, cpIdx) => {
        let earned = 0;
        let possible = 0;
        pkg.pg.forEach(q => {
          if (q.cpIdx === cpIdx) {
            possible += 1;
            if (sub.pgAnswers[q.no] === q.answer) earned += 1;
          }
        });
        pkg.uraian.forEach(u => {
          if (u.cpIdx === cpIdx) {
            possible += 2;
            earned += ((sub.essayScores[u.no] || 0) / 20) * 2;
          }
        });
        const pct = possible > 0 ? Math.round((earned / possible) * 100) : 0;
        return { cpIdx, name, pct };
      });
    }

    function updateSingleEssayScore(qNo, rawVal) {
      const sub = getActiveTeacherSubmission();
      if (!sub) return;
      const val = Math.max(0, Math.min(20, Number(rawVal) || 0));
      sub.essayScores[qNo] = val;
      recalculateSubmissionTotals(sub);
      saveSubmissionsToStorage();
      renderTeacherPortal();
    }

    function autoGradeCurrentEssays() {
      const sub = getActiveTeacherSubmission();
      if (!sub) return;
      const pkg = EXAM_PACKAGES.find(p => p.id === sub.packageId) || EXAM_PACKAGES[0];
      pkg.uraian.forEach(u => {
        sub.essayScores[u.no] = computeKeywordEssayScore(sub.essayAnswers[u.no] || '', u.keywords, 20);
      });
      recalculateSubmissionTotals(sub);
      saveSubmissionsToStorage();
      renderTeacherPortal();
      showToast('Penilaian otomatis rubrik kata kunci selesai diterapkan.', 'success');
    }

    function recalculateSubmissionTotals(sub) {
      const pkg = EXAM_PACKAGES.find(p => p.id === sub.packageId) || EXAM_PACKAGES[0];
      let essayTotal = 0;
      pkg.uraian.forEach(u => { essayTotal += Number(sub.essayScores[u.no] || 0); });
      sub.essayScore100 = Number(essayTotal.toFixed(1));
      sub.finalScore = Number((sub.pgScore100 * 0.6 + sub.essayScore100 * 0.4).toFixed(1));
    }

    function buildOfflinePedagogicalDiagnosis(sub, pkg, cpStats) {
      const sorted = [...cpStats].sort((a, b) => b.pct - a.pct);
      const strongest = sorted[0];
      const weakest = sorted[sorted.length - 1];
      return [
        `RINGKASAN EVALUASI INDIVIDUAL (${sub.studentName} — Kelas ${sub.studentClass})`,
        `• Capaian Nilai Akhir: ${sub.finalScore.toFixed(1)} (Skor PG: ${sub.pgScore100.toFixed(1)} | Skor Uraian: ${sub.essayScore100.toFixed(1)}).`,
        `• Kekuatan Utama (CP BSKAP): Peserta didik menunjukkan penguasaan paling menonjol pada elemen "${strongest.name}" dengan tingkat ketercapaian ${strongest.pct}%.`,
        `• Area Penguatan / Remedial: Perlu pendalaman konsep dan latihan analisis HOTS pada elemen "${weakest.name}" (${weakest.pct}%).`,
        `• Rekomendasi Tindak Lanjut: Lakukan latihan interaktif mandiri melalui portal Wayground (${pkg.waygroundUrl}) serta diskusikan pembahasan butir soal yang masih keliru bersama Guru Mata Pelajaran.`
      ].join('\n');
    }

    async function runGeminiOrOfflineDiagnosis() {
      const sub = getActiveTeacherSubmission();
      if (!sub) return;
      const pkg = EXAM_PACKAGES.find(p => p.id === sub.packageId) || EXAM_PACKAGES[0];
      const cpStats = computeCpMasteryBreakdown(sub, pkg);
      const apiKey = (localStorage.getItem(STORAGE_KEY_GEMINI_KEY) || '').trim();
      const btn = document.getElementById('btn-run-ai-analysis');
      const badge = document.getElementById('ai-engine-source-badge');

      if (!apiKey) {
        sub.aiDiagnosis = buildOfflinePedagogicalDiagnosis(sub, pkg, cpStats);
        saveSubmissionsToStorage();
        if (badge) badge.textContent = 'Diagnostik Lokal Cerdas';
        renderTeacherPortal();
        showToast('Analisis pedagogis lokal berhasil diperbarui.', 'info');
        return;
      }

      if (btn) btn.disabled = true;
      if (badge) badge.textContent = 'Menghubungi Gemini AI...';

      try {
        const wrongItems = pkg.pg.filter(q => sub.pgAnswers[q.no] !== q.answer).slice(0, 8).map(q => `No.${q.no} (${q.cpName})`);
        const prompt = `Anda adalah Pakar Evaluasi Pendidikan Kurikulum Merdeka Indonesia (BSNP & BSKAP). Buatlah evaluasi individual singkat (maksimal 180 kata, bahasa Indonesia formal & memotivasi) untuk siswa berikut:
Nama: ${sub.studentName}, Kelas: ${sub.studentClass}, Paket: ${pkg.title}
Nilai PG: ${sub.pgScore100}/100, Nilai Uraian: ${sub.essayScore100}/100, Nilai Akhir: ${sub.finalScore}/100.
Persentase CP: ${cpStats.map(c => `${c.name}: ${c.pct}%`).join('; ')}.
Contoh nomor keliru: ${wrongItems.join(', ') || 'Tidak ada'}.
Berikan: (1) Apresiasi kekuatan CP, (2) Diagnosis kelemahan konsep, (3) Saran belajar konkret.`;

        const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${encodeURIComponent(apiKey)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
        });
        const data = await resp.json();
        const aiText = data?.candidates?.[0]?.content?.parts?.[0]?.text;
        if (!aiText) throw new Error('Respons Gemini kosong');

        sub.aiDiagnosis = aiText.trim();
        saveSubmissionsToStorage();
        if (badge) badge.textContent = 'Gemini AI Aktif';
        renderTeacherPortal();
        showToast('Analisis mendalam Gemini AI berhasil dibuat!', 'success');
      } catch (err) {
        sub.aiDiagnosis = buildOfflinePedagogicalDiagnosis(sub, pkg, cpStats);
        saveSubmissionsToStorage();
        if (badge) badge.textContent = 'Fallback Diagnostik Lokal';
        renderTeacherPortal();
        showToast('API Gemini tidak terjangkau; menggunakan mesin diagnostik lokal.', 'warning');
      } finally {
        if (btn) btn.disabled = false;
      }
    }

