    }

    function autoScoreEssaysByKeywords(subId) {
      const sub = appState.submissions.find(s => s.id === subId);
      if (!sub) return;
      const pkg = EXAM_PACKAGES.find(p => p.id === sub.packageId);
      if (!pkg) return;

      if (!sub.essayScores) sub.essayScores = {};
      pkg.uraian.forEach(u => {
        const ans = (sub.essayAnswers && sub.essayAnswers[u.no] || '').toLowerCase();
        if (!ans.trim()) {
          sub.essayScores[u.no] = 0;
          return;
        }
        let hits = 0;
        u.keywords.forEach(kw => {
          if (ans.includes(kw.toLowerCase())) hits++;
        });
        const ratio = Math.min(1, hits / Math.max(3, Math.ceil(u.keywords.length * 0.55)));
        const lengthBonus = ans.length > 90 ? 2 : 0;
        sub.essayScores[u.no] = Math.min(u.maxScore, Math.round(ratio * 18) + lengthBonus);
      });

      saveSubmissions();
      renderTeacherPortal();
      showToast('Skor uraian dihitung otomatis berdasarkan rubrik kata kunci BSKAP.', 'success');
    }

    function updateManualEssayScore(subId, qNo, val) {
      const sub = appState.submissions.find(s => s.id === subId);
      if (!sub) return;
      if (!sub.essayScores) sub.essayScores = {};
      const num = Math.max(0, Math.min(20, Number(val) || 0));
      sub.essayScores[qNo] = num;
      saveSubmissions();
      renderTeacherPortal();
    }

    function buildOfflinePedagogicalDiagnostic(sub, metrics) {
      const entries = Object.entries(metrics.cpStats).map(([cp, st]) => ({
        cp,
        pct: Math.round((st.correct / st.total) * 100)
      }));
      entries.sort((a, b) => b.pct - a.pct);
      const strongest = entries[0];
      const weakest = entries[entries.length - 1];

      const predikat = metrics.finalScore >= 90 ? 'Sangat Baik (Mahir HOTS L3)'
        : metrics.finalScore >= 80 ? 'Baik (Cakap Kompetensi)'
        : metrics.finalScore >= 70 ? 'Cukup (Perlu Penguatan Analisis)'
        : 'Perlu Bimbingan Remedial Terstruktur';

      return `Berdasarkan hasil asesmen ${metrics.pkg.title}, peserta didik ${sub.studentName} (${sub.studentClass}) memperoleh Nilai Akhir ${metrics.finalScore.toFixed(1)} dengan predikat "${predikat}". Kekuatan utama terlihat pada elemen ${strongest.cp} (${strongest.pct}%), sedangkan aspek yang perlu pendampingan lebih lanjut adalah ${weakest.cp} (${weakest.pct}%). Rekomendasi tindak lanjut: berikan latihan studi kasus HOTS melalui Wayground (${metrics.pkg.waygroundUrl}) serta diskusi analisis stimulus terarah.`;
    }

    async function generateDiagnosticFeedback(subId) {
      const sub = appState.submissions.find(s => s.id === subId);
      if (!sub) return;
      const metrics = computeSubmissionMetrics(sub);
      const apiKey = localStorage.getItem(STORAGE_KEY_GEMINI_KEY) || '';

      if (!apiKey) {
        sub.aiFeedback = buildOfflinePedagogicalDiagnostic(sub, metrics);
        saveSubmissions();
