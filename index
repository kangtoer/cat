    function switchView(viewName) {
      const views = ['home', 'exam', 'result', 'proctor', 'teacher', 'deploy'];
      views.forEach(v => {
        const el = document.getElementById(`view-${v}`);
        if (el) {
          el.classList.toggle('hidden', v !== viewName);
        }
      });
      appState.currentView = viewName;

      if (viewName === 'proctor') renderProctorTable();
      if (viewName === 'teacher') renderTeacherPortal();
      if (viewName === 'deploy') renderRepoFilesGrid();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function toggleTheme() {
      const html = document.documentElement;
      const isDark = html.classList.toggle('dark');
      document.getElementById('theme-icon-sun').classList.toggle('hidden', !isDark);
      document.getElementById('theme-icon-moon').classList.toggle('hidden', isDark);
      localStorage.setItem('nusantara_theme', isDark ? 'dark' : 'light');
    }

    function openBsnpModal() {
      const m = document.getElementById('modal-bsnp');
      m.classList.remove('hidden');
      m.classList.add('flex');
    }

    function closeModal(id) {
      const m = document.getElementById(id);
      if (m) {
        m.classList.add('hidden');
        m.classList.remove('flex');
      }
    }

    function openAuthModal(role) {
      if (appState.authorizedRole === role || appState.authorizedRole === 'teacher') {
        switchView(role);
        return;
      }
      appState.pendingRoleTarget = role;
      const titleEl = document.getElementById('auth-modal-title');
      const descEl = document.getElementById('auth-modal-desc');
      const pinInput = document.getElementById('auth-pin-input');
      pinInput.value = '';

      if (role === 'proctor') {
        titleEl.textContent = 'Login Portal Proctor (Pengawas)';
        descEl.textContent = 'Masukkan PIN Proctor (Default: PROCTOR2026)';
      } else {
        titleEl.textContent = 'Login Portal Guru Mapel / Admin';
        descEl.textContent = 'Masukkan PIN Guru / Admin (Default: GURUIPS2026)';
      }

      const m = document.getElementById('modal-auth');
      m.classList.remove('hidden');
      m.classList.add('flex');
      setTimeout(() => pinInput.focus(), 80);
    }

    function submitRoleAuth(e) {
      e.preventDefault();
      const pin = document.getElementById('auth-pin-input').value.trim();
      const target = appState.pendingRoleTarget;

      if (target === 'proctor' && (pin === 'PROCTOR2026' || pin === 'GURUIPS2026')) {
        appState.authorizedRole = 'proctor';
        closeModal('modal-auth');
        switchView('proctor');
        showToast('Berhasil masuk ke Portal Proctor.', 'success');
      } else if (target === 'teacher' && pin === 'GURUIPS2026') {
        appState.authorizedRole = 'teacher';
        closeModal('modal-auth');
        switchView('teacher');
        showToast('Berhasil masuk ke Portal Guru Mapel & Admin.', 'success');
      } else {
        showToast('PIN otorisasi tidak sesuai. Periksa kembali PIN Anda.', 'error');
      }
    }

    function copyTextToClipboard(text, successMsg) {
      const temp = document.createElement('textarea');
      temp.value = text;
      temp.style.position = 'fixed';
      temp.style.opacity = '0';
      document.body.appendChild(temp);
      temp.select();
      try {
        document.execCommand('copy');
        showToast(successMsg || 'Teks berhasil disalin ke papan klip!', 'success');
      } catch (err) {
        showToast('Gagal menyalin otomatis. Silakan salin secara manual.', 'warning');
      }
      document.body.removeChild(temp);
    }

