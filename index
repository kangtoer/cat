    /* =====================================================================
       7. PROCTOR & TEACHER GRADING / DIAGNOSTICS / A4 PDF REPORT
    ===================================================================== */
    function computeSubmissionMetrics(sub) {
      const pkg = EXAM_PACKAGES.find(p => p.id === sub.packageId) || EXAM_PACKAGES[0];
      let pgCorrect = 0;
      const cpStats = {};

      pkg.pg.forEach(q => {
        if (!cpStats[q.cpElement]) cpStats[q.cpElement] = { total: 0, correct: 0 };
        cpStats[q.cpElement].total++;
        if (sub.pgAnswers && sub.pgAnswers[q.no] === q.answer) {
          pgCorrect++;
          cpStats[q.cpElement].correct++;
        }
      });

      const pgScore100 = (pgCorrect / pkg.pg.length) * 100;
      let essayRawSum = 0;
      let essayGradedCount = 0;
      pkg.uraian.forEach(u => {
        if (sub.essayScores && typeof sub.essayScores[u.no] === 'number') {
          essayRawSum += sub.essayScores[u.no];
          essayGradedCount++;
        }
      });
      // Essay max raw = 5 * 20 = 100
      const finalScore = (pgScore100 * 0.7) + (essayRawSum * 0.3);

      return {
        pkg,
        pgCorrect,
        pgScore100,
        essayRawSum,
        essayGradedCount,
        finalScore,
        cpStats
      };
    }

