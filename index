            <a href="${pkg.waygroundUrl}" target="_blank" rel="noopener" class="py-2.5 px-3.5 rounded-xl bg-amber-100 dark:bg-amber-900/40 text-amber-900 dark:text-amber-300 hover:bg-amber-200 font-bold text-xs transition">
              Wayground ${pkg.waygroundCode !== 'MANDIRI' ? `(${pkg.waygroundCode})` : '↗'}
