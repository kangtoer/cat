    function selectPackageAndFocusLogin(pkgId) {
      const sel = document.getElementById('stu-package');
      const nameInput = document.getElementById('stu-name');
      if (sel) sel.value = pkgId;
      if (nameInput) {
        nameInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
        nameInput.focus();
      }
      showToast('Paket ujian dipilih. Silakan lengkapi Nama dan Kelas Anda.', 'info');
    }

    /* =====================================================================
       6. STUDENT CBT & CAT ADAPTIVE EXAM ENGINE
    ===================================================================== */
    function handleStudentStart(e) {
      e.preventDefault();
      const name = document.getElementById('stu-name').value.trim();
      const cls = document.getElementById('stu-class').value.trim();
      const pin = document.getElementById('stu-pin').value.trim();
      const packageId = document.getElementById('stu-package').value;
      const mode = document.querySelector('input[name="exam-mode"]:checked').value;

      if (!name || !cls) {
        showToast('Harap isi Nama Lengkap dan Kelas terlebih dahulu.', 'warning');
        return;
      }

      const pkg = EXAM_PACKAGES.find(p => p.id === packageId);
      if (!pkg) return;

      // Build unified 45-item array (40 PG + 5 Uraian)
      const items = [
        ...pkg.pg.map(q => ({ ...q, type: 'pg', globalIndex: q.no - 1 })),
        ...pkg.uraian.map((u, idx) => ({ ...u, type: 'uraian', globalIndex: 40 + idx }))
      ];

      appState.activeExam = {
        studentName: name,
        studentClass: cls,
        pin: pin,
        packageId: pkg.id,
        packageTitle: pkg.title,
        waygroundUrl: pkg.waygroundUrl,
        mode: mode,
        items: items,
        currentIndex: 0,
        pgAnswers: {},
        essayAnswers: {},
        flagged: {},
        tabViolations: 0,
        secondsRemaining: pkg.durationMinutes * 60,
        theta: 0.0,
        catVisited: [0]
      };

      startExamWorkspace();
    }

    function startExamWorkspace() {
      const ex = appState.activeExam;
      if (!ex) return;

      document.getElementById('exam-pkg-title').textContent = ex.packageTitle;
      document.getElementById('exam-student-meta').textContent = `${ex.studentName} • ${ex.studentClass}`;

      const modeBadge = document.getElementById('exam-mode-badge');
      const catPanel = document.getElementById('cat-theta-panel');
      if (ex.mode === 'cat') {
        modeBadge.textContent = 'CAT ADAPTIF (IRT θ)';
        modeBadge.className = 'px-3 py-1 rounded-lg text-xs font-extrabold uppercase bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300';
        catPanel.classList.remove('hidden');
        catPanel.classList.add('flex');
      } else {
        modeBadge.textContent = 'CBT STANDAR';
        modeBadge.className = 'px-3 py-1 rounded-lg text-xs font-extrabold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300';
        catPanel.classList.add('hidden');
        catPanel.classList.remove('flex');
      }

      document.getElementById('tab-violation-count').textContent = ex.tabViolations;
      switchView('exam');
      renderExamNavigationGrid();
      renderCurrentQuestion();
      startExamCountdown();
    }

    function startExamCountdown() {
      if (appState.examTimerInterval) clearInterval(appState.examTimerInterval);
      updateTimerDisplay();
      appState.examTimerInterval = setInterval(() => {
        if (!appState.activeExam || appState.currentView !== 'exam') return;
        appState.activeExam.secondsRemaining--;
        updateTimerDisplay();
        if (appState.activeExam.secondsRemaining <= 0) {
          clearInterval(appState.examTimerInterval);
          finalizeExamSubmission();
        }
      }, 1000);
    }

    function updateTimerDisplay() {
      const ex = appState.activeExam;
      if (!ex) return;
      const mins = Math.max(0, Math.floor(ex.secondsRemaining / 60));
      const secs = Math.max(0, ex.secondsRemaining % 60);
      document.getElementById('exam-timer-display').textContent =
        `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
    }

    function setExamFont(size) {
      const stim = document.getElementById('q-stimulus-box');
      const stem = document.getElementById('q-stem-text');
      const essay = document.getElementById('q-essay-textarea');
      [stim, stem, essay].forEach(el => {
        if (!el) return;
        el.classList.remove('exam-font-sm', 'exam-font-md', 'exam-font-lg');
        el.classList.add(`exam-font-${size}`);
      });
    }

    function renderCurrentQuestion() {
      const ex = appState.activeExam;
      if (!ex) return;
      const item = ex.items[ex.currentIndex];
      const displayNo = ex.currentIndex + 1;

      document.getElementById('q-number-badge').textContent = `Soal No. ${displayNo}`;
      document.getElementById('q-type-badge').textContent = item.type === 'pg' ? 'Pilihan Ganda' : 'Uraian Analitis';
      document.getElementById('q-level-badge').textContent = `HOTS ${item.level}`;
      document.getElementById('q-cp-tag').textContent = `Elemen CP: ${item.cpElement}`;

      document.getElementById('q-stimulus-box').textContent = item.stimulus;
      document.getElementById('q-stem-text').textContent = item.question;

      const optContainer = document.getElementById('q-options-container');
      const essayContainer = document.getElementById('q-essay-container');

      if (item.type === 'pg') {
        optContainer.classList.remove('hidden');
        essayContainer.classList.add('hidden');
        const selected = ex.pgAnswers[item.no] || '';
        optContainer.innerHTML = ['A', 'B', 'C', 'D'].map(key => {
          const isChecked = selected === key;
          return `
            <button type="button" onclick="selectPgAnswer(${item.no}, '${key}')" class="w-full text-left p-4 rounded-2xl border-2 transition flex items-start gap-3.5 ${
              isChecked
                ? 'border-emerald-600 bg-emerald-50/80 dark:bg-emerald-950/40 text-slate-900 dark:text-white'
                : 'border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700 bg-white dark:bg-slate-900'
            }">
              <span class="w-8 h-8 rounded-xl flex items-center justify-center font-extrabold text-sm shrink-0 ${
                isChecked
                  ? 'bg-emerald-600 text-white'
                  : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300'
              }">${key}</span>
              <span class="pt-1 text-sm sm:text-base leading-relaxed">${item.options[key]}</span>
            </button>
          `;
        }).join('');
      } else {
        optContainer.classList.add('hidden');
        essayContainer.classList.remove('hidden');
        const currentEssay = ex.essayAnswers[item.no] || '';
        const ta = document.getElementById('q-essay-textarea');
        ta.value = currentEssay;
        document.getElementById('essay-char-count').textContent = `${currentEssay.length} karakter`;
      }

      // Update CAT Theta Panel if active
      if (ex.mode === 'cat') {
        document.getElementById('cat-theta-value').textContent = ex.theta.toFixed(2);
        document.getElementById('cat-level-badge').textContent = `Target ${item.level}`;
      }

      document.getElementById('btn-prev-q').disabled = ex.currentIndex === 0;
      document.getElementById('btn-prev-q').classList.toggle('opacity-40', ex.currentIndex === 0);
      document.getElementById('btn-next-q').textContent =
        ex.currentIndex === ex.items.length - 1 ? 'Selesai Review ✓' : 'Selanjutnya →';

      renderExamNavigationGrid();
    }

    function selectPgAnswer(qNo, optionKey) {
      const ex = appState.activeExam;
      if (!ex) return;
      ex.pgAnswers[qNo] = optionKey;

      // Adaptive CAT theta update on PG answer
      if (ex.mode === 'cat') {
        const item = ex.items[ex.currentIndex];
        const isCorrect = optionKey === item.answer;
        const delta = item.level === 'C6' ? 0.25 : item.level === 'C5' ? 0.18 : 0.12;
        ex.theta = Math.max(-2.5, Math.min(2.5, ex.theta + (isCorrect ? delta : -delta * 0.8)));
      }

      renderCurrentQuestion();
    }

    function saveCurrentEssayAnswer(val) {
      const ex = appState.activeExam;
      if (!ex) return;
      const item = ex.items[ex.currentIndex];
      if (item.type === 'uraian') {
        ex.essayAnswers[item.no] = val;
        document.getElementById('essay-char-count').textContent = `${val.length} karakter`;
        renderExamNavigationGrid();
      }
    }

    function toggleFlagQuestion() {
      const ex = appState.activeExam;
      if (!ex) return;
      ex.flagged[ex.currentIndex] = !ex.flagged[ex.currentIndex];
      renderExamNavigationGrid();
    }

    function jumpToQuestion(idx) {
      const ex = appState.activeExam;
      if (!ex) return;
      ex.currentIndex = idx;
      renderCurrentQuestion();
    }

    function prevQuestion() {
      const ex = appState.activeExam;
      if (!ex || ex.currentIndex <= 0) return;
      ex.currentIndex--;
      renderCurrentQuestion();
    }

    function nextQuestion() {
      const ex = appState.activeExam;
      if (!ex) return;
      if (ex.currentIndex >= ex.items.length - 1) {
        openFinishConfirmModal();
        return;
      }

      // In CAT mode, adaptively route unvisited PG questions based on theta ability
      if (ex.mode === 'cat' && ex.currentIndex < 39) {
        const targetLevel = ex.theta >= 0.75 ? 'C6' : ex.theta >= 0.15 ? 'C5' : 'C4';
        const unvisitedMatch = ex.items.findIndex(
          (it, idx) => it.type === 'pg' && !ex.pgAnswers[it.no] && idx !== ex.currentIndex && it.level === targetLevel
        );
        if (unvisitedMatch !== -1) {
          ex.currentIndex = unvisitedMatch;
          renderCurrentQuestion();
          return;
        }
      }

      ex.currentIndex++;
      renderCurrentQuestion();
    }

    function renderExamNavigationGrid() {
      const ex = appState.activeExam;
      const grid = document.getElementById('question-nav-grid');
      if (!ex || !grid) return;

      let answeredCount = 0;
      grid.innerHTML = ex.items.map((item, idx) => {
        const isAnswered = item.type === 'pg'
          ? Boolean(ex.pgAnswers[item.no])
          : Boolean((ex.essayAnswers[item.no] || '').trim());
        if (isAnswered) answeredCount++;

        const isFlagged = Boolean(ex.flagged[idx]);
        const isCurrent = idx === ex.currentIndex;

        let cls = 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300';
        if (isFlagged) {
          cls = 'bg-amber-400 text-slate-950';
        } else if (isAnswered) {
          cls = 'bg-emerald-600 text-white';
        }
        if (isCurrent) {
          cls += ' ring-2 ring-offset-2 ring-navy-900 dark:ring-white';
        }

        return `
          <button type="button" onclick="jumpToQuestion(${idx})" class="h-9 rounded-xl font-mono font-bold text-xs transition ${cls}">
            ${idx + 1}
          </button>
        `;
      }).join('');

      document.getElementById('exam-progress-text').textContent = `${answeredCount} / ${ex.items.length} Terjawab`;
    }

    function openFinishConfirmModal() {
      const ex = appState.activeExam;
      if (!ex) return;
      let answeredCount = 0;
      ex.items.forEach(item => {
        const ok = item.type === 'pg'
          ? Boolean(ex.pgAnswers[item.no])
          : Boolean((ex.essayAnswers[item.no] || '').trim());
        if (ok) answeredCount++;
      });

      document.getElementById('finish-summary-text').textContent =
        `Anda telah menjawab ${answeredCount} dari ${ex.items.length} butir soal. Setelah dikumpulkan, jawaban tidak dapat diubah kembali.`;
      const m = document.getElementById('modal-finish-confirm');
      m.classList.remove('hidden');
      m.classList.add('flex');
    }

    function finalizeExamSubmission() {
      closeModal('modal-finish-confirm');
      const ex = appState.activeExam;
      if (!ex) return;
      if (appState.examTimerInterval) clearInterval(appState.examTimerInterval);

      const pkg = EXAM_PACKAGES.find(p => p.id === ex.packageId);
      let correctPg = 0;
      pkg.pg.forEach(q => {
        if (ex.pgAnswers[q.no] === q.answer) correctPg++;
      });

      const subId = `SUB-${Date.now().toString().slice(-6)}`;
      const nowStr = new Date().toLocaleString('id-ID', {
        year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
      }) + ' WIB';

      const newRecord = {
        id: subId,
        studentName: ex.studentName,
        studentClass: ex.studentClass,
        packageId: ex.packageId,
        mode: ex.mode,
        theta: Number(ex.theta.toFixed(2)),
        submittedAt: nowStr,
        tabViolations: ex.tabViolations,
        pgAnswers: { ...ex.pgAnswers },
        essayAnswers: { ...ex.essayAnswers },
        essayScores: {},
        aiFeedback: ''
      };

      appState.submissions.unshift(newRecord);
      appState.lastFinishedSubmission = newRecord;
      saveSubmissions();

      // Populate Result Screen
      const pgScore100 = ((correctPg / pkg.pg.length) * 100).toFixed(1);
      document.getElementById('res-student-name').textContent = newRecord.studentName;
      document.getElementById('res-exam-meta').textContent = `${newRecord.studentClass} • ${pkg.title}`;
      document.getElementById('res-pg-score').textContent = pgScore100;
      document.getElementById('res-pg-detail').textContent = `${correctPg} Benar dari ${pkg.pg.length} Soal PG`;
      document.getElementById('res-mode-theta').textContent =
        newRecord.mode === 'cat' ? `CAT Adaptif (θ = ${newRecord.theta})` : 'CBT Standar (45 Butir)';
      document.getElementById('res-violations').textContent = `Catatan Pindah Tab: ${newRecord.tabViolations} kali`;
      document.getElementById('res-wayground-link').href = pkg.waygroundUrl;

      appState.activeExam = null;
      switchView('result');
      showToast('Jawaban berhasil dikumpulkan dan tersimpan!', 'success');
    }

