            <span>Buka Beranda Wayground</span>
            <span>↗</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-4" id="wayground-cards-grid">
          <!-- Populated dynamically by JS -->
        </div>
      </div>

      <!-- 4 EXAM PACKAGES CATALOG -->
