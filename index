      const rows = appState.submissions.map(s => [
        `"${s.studentName}"`,
        `"${s.studentClass}"`,
        `"${s.packageTitle}"`,
        s.mode.toUpperCase(),
        s.pgCorrect,
        s.pgScore100,
        s.essayScore100,
        s.finalScore,
        s.tabViolations || 0,
        s.submittedAt
      ].join(','));

      const csv = [headers.join(','), ...rows].join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Rekap_Nilai_CAT_BSKAP_${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
