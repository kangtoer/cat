    function updateWorkflowStepper(viewName) {
      const stepper = document.getElementById('cat-workflow-stepper');
      if (!stepper) return;

      const isAdminPortal = ['proctor', 'teacher', 'deploy'].includes(viewName);
      stepper.classList.toggle('hidden', isAdminPortal);
      if (isAdminPortal) return;

      const activeStepMap = { home: 1, confirm: 2, exam: 3, result: 4 };
      const currentStep = activeStepMap[viewName] || 1;

      [1, 2, 3, 4].forEach(stepNum => {
        const el = document.getElementById(`wf-step-${stepNum}`);
        if (!el) return;
        const badge = el.querySelector('span');
        if (stepNum < currentStep) {
          el.className = 'flex items-center gap-2 shrink-0 font-bold text-emerald-700 dark:text-emerald-400';
          if (badge) {
            badge.className = 'w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/60 text-emerald-700 dark:text-emerald-300 flex items-center justify-center text-[11px] font-extrabold';
            badge.textContent = '✓';
          }
        } else if (stepNum === currentStep) {
          el.className = 'flex items-center gap-2 shrink-0 font-extrabold text-slate-900 dark:text-white';
          if (badge) {
            badge.className = 'w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center text-[11px] font-extrabold ring-2 ring-emerald-300 dark:ring-emerald-700';
            badge.textContent = String(stepNum);
          }
        } else {
          el.className = 'flex items-center gap-2 shrink-0 font-semibold text-slate-400 dark:text-slate-500';
          if (badge) {
            badge.className = 'w-6 h-6 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 flex items-center justify-center text-[11px] font-extrabold';
            badge.textContent = String(stepNum);
          }
        }
      });

      [1, 2, 3].forEach(lineNum => {
        const line = document.getElementById(`wf-line-${lineNum}`);
        if (!line) return;
        if (lineNum < currentStep) {
          line.className = 'h-0.5 flex-1 min-w-[24px] bg-emerald-500 rounded-full';
        } else {
          line.className = 'h-0.5 flex-1 min-w-[24px] bg-slate-200 dark:bg-slate-800 rounded-full';
        }
      });
    }

