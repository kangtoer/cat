    /* =====================================================================
       7. OFFICIAL 4-STAGE STUDENT CAT & CBT EXAM ENGINE
    ===================================================================== */
    function handleStudentStart(e) {
      e.preventDefault();
      const name = document.getElementById('stu-name').value.trim();
      const cls = document.getElementById('stu-class').value.trim();
      const personalPin = document.getElementById('stu-personal-pin').value.trim();
      const sessionToken = document.getElementById('stu-session-token').value.trim().toUpperCase();
      const packageId = document.getElementById('stu-package').value;
      const mode = document.querySelector('input[name="exam-mode"]:checked').value;

      if (!name || !cls || !personalPin) {
        showToast('Harap isi Nama Lengkap, Kelas, dan Password/PIN Pribadi terlebih dahulu.', 'warning');
        return;
      }

      if (sessionToken !== appState.sessionToken.toUpperCase()) {
        showToast(`Token Sesi tidak sesuai! Token aktif saat ini: ${appState.sessionToken}`, 'error');
        return;
      }

      const pkg = EXAM_PACKAGES.find(p => p.id === packageId);
      if (!pkg) return;

      appState.pendingCandidate = {
        studentName: name,
        studentClass: cls,
        personalPin: personalPin,
        sessionToken: sessionToken,
        packageId: pkg.id,
        mode: mode
      };

      document.getElementById('conf-token-badge').textContent = `TOKEN: ${sessionToken}`;
      document.getElementById('conf-stu-name').textContent = name;
      document.getElementById('conf-stu-class').textContent = cls;
      document.getElementById('conf-pkg-title').textContent = pkg.title;
      document.getElementById('conf-pkg-specs').textContent = `45 Butir (40 PG + 5 Uraian) • ${pkg.durationMinutes} Menit`;
      document.getElementById('conf-exam-mode').textContent =
        mode === 'cat' ? 'CAT Adaptif (Routing IRT θ: C4 → C5 → C6)' : 'CBT Standar (Navigasi Terstruktur 45 Soal)';

      const cb = document.getElementById('conf-integrity-checkbox');
      if (cb) cb.checked = false;

      switchView('confirm');
      showToast('Token Sesi terverifikasi. Periksa kartu identitas Anda.', 'info');
    }

    function cancelPreExamConfirm() {
      appState.pendingCandidate = null;
      switchView('home');
    }

    function confirmAndLaunchExam() {
      const cb = document.getElementById('conf-integrity-checkbox');
      if (!cb || !cb.checked) {
        showToast('Centang pernyataan Pakta Integritas terlebih dahulu sebelum memulai ujian.', 'warning');
        return;
      }

      const cand = appState.pendingCandidate;
      if (!cand) {
        switchView('home');
        return;
      }

      const pkg = EXAM_PACKAGES.find(p => p.id === cand.packageId);
      if (!pkg) return;

      const items = [
        ...pkg.pg.map(q => ({ ...q, type: 'pg', globalIndex: q.no - 1 })),
        ...pkg.uraian.map((u, idx) => ({ ...u, type: 'uraian', globalIndex: 40 + idx }))
      ];

      appState.activeExam = {
        studentName: cand.studentName,
        studentClass: cand.studentClass,
        personalPin: cand.personalPin,
        packageId: pkg.id,
        packageTitle: pkg.title,
        waygroundUrl: pkg.waygroundUrl,
        mode: cand.mode,
        items: items,
        currentIndex: 0,
        pgAnswers: {},
        essayAnswers: {},
        flagged: {},
        tabViolations: 0,
        secondsRemaining: pkg.durationMinutes * 60,
        theta: 0.0
      };

      appState.pendingCandidate = null;
      persistActiveSessionToStorage();
      startExamWorkspace();
    }

    function startExamWorkspace() {
      const ex = appState.activeExam;
      if (!ex) return;

      document.getElementById('exam-header-student').textContent = ex.studentName;
      document.getElementById('exam-header-class').textContent = ex.studentClass;
      document.getElementById('exam-header-pkg').textContent = ex.packageTitle;
      document.getElementById('exam-header-mode').textContent = ex.mode === 'cat' ? 'CAT ADAPTIF (IRT θ)' : 'CBT STANDAR';

      const thetaBox = document.getElementById('cat-theta-box');
      if (thetaBox) thetaBox.classList.toggle('hidden', ex.mode !== 'cat');

      switchView('exam');
      renderExamQuestion();
      renderQuestionNavGrid();
      startExamTimers();
      showToast(`Sesi ujian dimulai! Selamat mengerjakan, ${ex.studentName}.`, 'success');
    }

    function startExamTimers() {
      clearInterval(appState.examTimerInterval);
      clearInterval(appState.autoSaveInterval);

      updateTimerDisplay();
      appState.examTimerInterval = setInterval(() => {
        if (!appState.activeExam) return;
        appState.activeExam.secondsRemaining--;
        updateTimerDisplay();
        if (appState.activeExam.secondsRemaining <= 0) {
          clearInterval(appState.examTimerInterval);
          finalizeAndSubmitExam(true);
        }
      }, 1000);

      appState.autoSaveInterval = setInterval(() => {
        if (appState.activeExam) persistActiveSessionToStorage();
      }, 10000);
    }

    function updateTimerDisplay() {
      const ex = appState.activeExam;
      if (!ex) return;
      const s = Math.max(0, ex.secondsRemaining);
      const hrs = String(Math.floor(s / 3600)).padStart(2, '0');
      const mins = String(Math.floor((s % 3600) / 60)).padStart(2, '0');
      const secs = String(s % 60).padStart(2, '0');
      const txt = document.getElementById('exam-timer-text');
      const box = document.getElementById('exam-timer-box');
      if (txt) txt.textContent = `${hrs}:${mins}:${secs}`;
      if (box) {
        if (s < 180) {
          box.className = 'px-4 py-2 rounded-xl bg-rose-600 text-white font-mono font-extrabold text-sm sm:text-base flex items-center gap-2 shadow-sm animate-pulse';
        } else if (s < 600) {
          box.className = 'px-4 py-2 rounded-xl bg-amber-500 text-slate-950 font-mono font-extrabold text-sm sm:text-base flex items-center gap-2 shadow-sm';
        } else {
          box.className = 'px-4 py-2 rounded-xl bg-slate-900 text-white font-mono font-extrabold text-sm sm:text-base flex items-center gap-2 shadow-sm';
        }
      }
      const vCount = document.getElementById('tab-violation-count');
      if (vCount) vCount.textContent = String(ex.tabViolations || 0);
    }

    function renderExamQuestion() {
      const ex = appState.activeExam;
      if (!ex) return;
      const idx = ex.currentIndex;
      const item = ex.items[idx];
      if (!item) return;

      document.getElementById('q-number-badge').textContent = `SOAL NO. ${idx + 1} / ${ex.items.length}`;
      document.getElementById('q-type-badge').textContent = item.type === 'pg' ? 'Pilihan Ganda HOTS' : 'Uraian Analitis (Rubrik)';
      document.getElementById('q-level-badge').textContent = item.level;
      document.getElementById('q-cp-badge').textContent = item.cpName;
      document.getElementById('q-stimulus-box').textContent = item.stimulus;
      document.getElementById('q-stem-text').textContent = item.question;

      const optContainer = document.getElementById('q-options-container');
      const essayContainer = document.getElementById('q-essay-container');

      if (item.type === 'pg') {
        optContainer.classList.remove('hidden');
        essayContainer.classList.add('hidden');
        const chosen = ex.pgAnswers[item.no] || '';
        optContainer.innerHTML = ['A', 'B', 'C', 'D'].map(key => {
          const isSelected = chosen === key;
          const borderCls = isSelected
            ? 'border-emerald-600 bg-emerald-50/90 dark:bg-emerald-950/50 ring-2 ring-emerald-500/30'
            : 'border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 hover:border-emerald-400 hover:bg-slate-50 dark:hover:bg-slate-800/60';
          const badgeCls = isSelected
            ? 'bg-emerald-600 text-white border-emerald-600'
            : 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-300 dark:border-slate-700';
          return `
            <button type="button" onclick="selectPgAnswer(${item.no}, '${key}')" class="option-card w-full text-left p-4 rounded-2xl border-2 flex items-start gap-3.5 ${borderCls}">
              <span class="w-8 h-8 rounded-xl border font-mono font-extrabold text-xs sm:text-sm flex items-center justify-center shrink-0 mt-0.5 ${badgeCls}">
                ${key}
              </span>
              <span class="exam-text-scale font-medium text-slate-800 dark:text-slate-100 flex-1">${escapeHtml(item.options[key])}</span>
            </button>
          `;
        }).join('');
      } else {
        optContainer.classList.add('hidden');
        essayContainer.classList.remove('hidden');
        const essayBox = document.getElementById('q-essay-input');
        const val = ex.essayAnswers[item.no] || '';
        essayBox.value = val;
        updateEssayWordCounter(val);
      }

      const flagBtn = document.getElementById('btn-flag-q');
      const isFlagged = Boolean(ex.flagged[idx]);
      if (flagBtn) {
        flagBtn.innerHTML = isFlagged ? '<span>⚑ Hapus Tanda Ragu</span>' : '<span>⚑ Tandai Ragu-ragu</span>';
      }

      const prevBtn = document.getElementById('btn-prev-q');
      if (prevBtn) prevBtn.disabled = idx === 0;

      const nextBtn = document.getElementById('btn-next-q');
      if (nextBtn) {
        if (idx === ex.items.length - 1) {
          nextBtn.innerHTML = '<span>✓ Selesai Ujian</span>';
          nextBtn.onclick = () => openFinishConfirmModal();
        } else {
          nextBtn.innerHTML = '<span>Selanjutnya →</span>';
          nextBtn.onclick = () => nextQuestion();
        }
      }
    }

    function selectPgAnswer(qNo, choiceKey) {
      const ex = appState.activeExam;
      if (!ex) return;
      ex.pgAnswers[qNo] = choiceKey;

      if (ex.mode === 'cat') {
        const item = ex.items[ex.currentIndex];
        if (item && item.type === 'pg') {
          const isCorrect = choiceKey === item.answer;
          ex.theta = Math.max(-3.0, Math.min(3.0, Number((ex.theta + (isCorrect ? 0.14 : -0.11)).toFixed(2))));
          const tv = document.getElementById('cat-theta-val');
          if (tv) tv.textContent = (ex.theta >= 0 ? '+' : '') + ex.theta.toFixed(2);
        }
      }

      persistActiveSessionToStorage();
      renderExamQuestion();
      renderQuestionNavGrid();
    }

    function handleEssayInput(textVal) {
      const ex = appState.activeExam;
      if (!ex) return;
      const item = ex.items[ex.currentIndex];
      if (!item || item.type !== 'uraian') return;
      ex.essayAnswers[item.no] = textVal;
      updateEssayWordCounter(textVal);
      renderQuestionNavGrid();
    }

    function updateEssayWordCounter(textVal) {
      const trimmed = (textVal || '').trim();
      const words = trimmed ? trimmed.split(/\s+/).length : 0;
      const chars = (textVal || '').length;
      const el = document.getElementById('q-essay-wordcount');
      if (el) el.textContent = `${words} kata • ${chars} karakter`;
    }

    function toggleFlagQuestion() {
      const ex = appState.activeExam;
      if (!ex) return;
      ex.flagged[ex.currentIndex] = !ex.flagged[ex.currentIndex];
      persistActiveSessionToStorage();
      renderExamQuestion();
      renderQuestionNavGrid();
    }

    function jumpToQuestion(targetIdx) {
      const ex = appState.activeExam;
      if (!ex) return;
      if (targetIdx < 0 || targetIdx >= ex.items.length) return;
      ex.currentIndex = targetIdx;
      renderExamQuestion();
      renderQuestionNavGrid();
    }

    function prevQuestion() {
      if (!appState.activeExam) return;
      if (appState.activeExam.currentIndex > 0) {
        jumpToQuestion(appState.activeExam.currentIndex - 1);
      }
    }

    function nextQuestion() {
      const ex = appState.activeExam;
      if (!ex) return;
      if (ex.mode === 'cat' && ex.currentIndex < 39) {
        // Adaptive routing: prioritize unanswered PG matching current theta difficulty
        const unansweredIndices = [];
        for (let i = 0; i < 40; i++) {
          const it = ex.items[i];
          if (!ex.pgAnswers[it.no]) unansweredIndices.push(i);
        }
        if (unansweredIndices.length > 0) {
          const wantHard = ex.theta >= 0.25;
          const preferred = unansweredIndices.find(i =>
            wantHard ? ex.items[i].level.includes('C5') : ex.items[i].level.includes('C4')
          );
          jumpToQuestion(preferred !== undefined ? preferred : unansweredIndices[0]);
          return;
        }
      }
      if (ex.currentIndex < ex.items.length - 1) {
        jumpToQuestion(ex.currentIndex + 1);
      }
    }

    function renderQuestionNavGrid() {
      const ex = appState.activeExam;
      const grid = document.getElementById('question-nav-grid');
      if (!ex || !grid) return;

      let answeredCount = 0;
      grid.innerHTML = ex.items.map((item, idx) => {
        const pgAns = item.type === 'pg' ? (ex.pgAnswers[item.no] || '') : '';
        const isAnswered = item.type === 'pg'
          ? Boolean(pgAns)
          : Boolean((ex.essayAnswers[item.no] || '').trim());
        if (isAnswered) answeredCount++;

        const isFlagged = Boolean(ex.flagged[idx]);
        const isCurrent = idx === ex.currentIndex;

        let cls = 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700';
        if (isFlagged) {
          cls = 'bg-amber-400 text-slate-950';
        } else if (isAnswered) {
          cls = 'bg-emerald-600 text-white';
        }
        if (isCurrent) {
          cls += ' ring-2 ring-offset-2 ring-slate-900 dark:ring-white';
        }

        const miniChoiceBadge = item.type === 'pg' && pgAns
          ? `<span class="text-[9px] font-extrabold opacity-90">(${pgAns})</span>`
          : '';

        return `
          <button type="button" onclick="jumpToQuestion(${idx})" class="h-10 rounded-xl font-mono font-bold text-xs transition flex flex-col items-center justify-center leading-none ${cls}">
            <span>${idx + 1}</span>
            ${miniChoiceBadge}
          </button>
        `;
      }).join('');

      document.getElementById('exam-progress-text').textContent = `${answeredCount} / ${ex.items.length} Terjawab`;
    }

    let currentFontScale = 16;
    function adjustExamFont(delta) {
      if (delta === 0) currentFontScale = 16;
      else currentFontScale = Math.max(13, Math.min(22, currentFontScale + delta));
      document.documentElement.style.setProperty('--exam-font-size', `${currentFontScale}px`);
    }

    function openFinishConfirmModal() {
      const ex = appState.activeExam;
      if (!ex) return;
      let answered = 0;
      ex.items.forEach(it => {
        const ok = it.type === 'pg' ? Boolean(ex.pgAnswers[it.no]) : Boolean((ex.essayAnswers[it.no] || '').trim());
        if (ok) answered++;
      });
      const unanswered = ex.items.length - answered;
      const summary = document.getElementById('finish-confirm-summary');
      if (summary) {
        summary.innerHTML = unanswered > 0
          ? `Anda telah menjawab <strong>${answered} dari ${ex.items.length} soal</strong>. Masih terdapat <strong class="text-rose-600">${unanswered} soal belum terjawab</strong>. Yakin ingin mengumpulkan sekarang?`
          : `Seluruh <strong>${ex.items.length} butir soal</strong> telah terjawab lengkap. Klik <strong>Ya, Kumpulkan Sekarang</strong> untuk mengakhiri sesi ujian.`;
      }
      const m = document.getElementById('modal-finish-confirm');
      if (m) { m.classList.remove('hidden'); m.classList.add('flex'); }
    }

    function computeKeywordEssayScore(answerText, keywords, maxScore = 20) {
      const clean = (answerText || '').toLowerCase().trim();
      if (!clean) return 0;
      let matched = 0;
      (keywords || []).forEach(kw => {
        if (clean.includes(kw.toLowerCase())) matched++;
      });
      const ratio = keywords && keywords.length > 0 ? matched / keywords.length : 0;
      const lengthBonus = clean.length >= 80 ? 0.15 : 0;
      return Math.min(maxScore, Math.round((ratio + lengthBonus) * maxScore));
    }

    function finalizeAndSubmitExam(isTimeout = false) {
      closeModal('modal-finish-confirm');
      const ex = appState.activeExam;
      if (!ex) return;

      clearInterval(appState.examTimerInterval);
      clearInterval(appState.autoSaveInterval);

      const pkg = EXAM_PACKAGES.find(p => p.id === ex.packageId);
      if (!pkg) return;

      let pgCorrect = 0;
      pkg.pg.forEach(q => {
        if (ex.pgAnswers[q.no] === q.answer) pgCorrect++;
      });
      const pgScore100 = Number(((pgCorrect / pkg.pg.length) * 100).toFixed(1));

      const essayScores = {};
      let essayRawTotal = 0;
      pkg.uraian.forEach(u => {
        const sc = computeKeywordEssayScore(ex.essayAnswers[u.no] || '', u.keywords, 20);
        essayScores[u.no] = sc;
        essayRawTotal += sc;
      });
      const essayScore100 = Number(essayRawTotal.toFixed(1));
      const finalScore = Number((pgScore100 * 0.6 + essayScore100 * 0.4).toFixed(1));

      const submission = {
        id: 'SUB-' + Date.now(),
        submittedAt: new Date().toISOString(),
        studentName: ex.studentName,
        studentClass: ex.studentClass,
        personalPin: ex.personalPin,
        packageId: pkg.id,
        packageTitle: pkg.title,
        waygroundUrl: pkg.waygroundUrl,
        mode: ex.mode,
        theta: ex.theta,
        tabViolations: ex.tabViolations,
        pgAnswers: { ...ex.pgAnswers },
        essayAnswers: { ...ex.essayAnswers },
        essayScores: essayScores,
        pgCorrect: pgCorrect,
        pgScore100: pgScore100,
        essayScore100: essayScore100,
        finalScore: finalScore,
        aiDiagnosis: ''
      };

      appState.submissions.unshift(submission);
      saveSubmissionsToStorage();
      appState.lastFinishedSubmission = submission;
      appState.selectedSubmissionId = submission.id;
      appState.activeExam = null;
      localStorage.removeItem(STORAGE_KEY_ACTIVE_SESSION);

      renderPostExamReceipt(submission);
      switchView('result');
      showToast(
        isTimeout ? 'Waktu ujian habis! Jawaban otomatis dikumpulkan.' : 'Jawaban berhasil dikumpulkan & direkam!',
        'success'
      );
    }

    function renderPostExamReceipt(sub) {
      document.getElementById('res-student-name').textContent = sub.studentName;
      document.getElementById('res-exam-meta').textContent = `Kelas ${sub.studentClass} • ${sub.packageTitle}`;
      document.getElementById('res-pg-score').textContent = sub.pgScore100.toFixed(1);
      document.getElementById('res-pg-detail').textContent = `${sub.pgCorrect} Benar dari 40 Soal Pilihan Ganda`;
      document.getElementById('res-mode-theta').textContent =
        sub.mode === 'cat' ? `CAT Adaptif (θ = ${sub.theta >= 0 ? '+' : ''}${sub.theta.toFixed(2)})` : 'CBT Standar Terstruktur';
      document.getElementById('res-violations').textContent = `Catatan Pindah Tab: ${sub.tabViolations} kali`;
      const wgLink = document.getElementById('res-wayground-link');
      if (wgLink) wgLink.href = sub.waygroundUrl || 'https://wayground.com';

      const tokenBox = document.getElementById('res-offline-token');
      if (tokenBox) tokenBox.value = JSON.stringify(sub);
    }

    function downloadLastResultJson() {
      const sub = appState.lastFinishedSubmission;
      if (!sub) return;
      const blob = new Blob([JSON.stringify(sub, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `Hasil_CAT_${sub.studentName.replace(/\s+/g, '_')}_${sub.packageId}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('File hasil ujian (.JSON) berhasil diunduh.', 'success');
    }

    function copyLastResultToken() {
      const box = document.getElementById('res-offline-token');
      if (!box || !box.value) return;
      copyTextToClipboard(box.value, 'Token hasil offline berhasil disalin!');
    }

    /* =====================================================================
       8. SESSION PERSISTENCE & INTEGRITY VISIBILITY LISTENER
    ===================================================================== */
    function persistActiveSessionToStorage() {
      if (!appState.activeExam) return;
      try {
        localStorage.setItem(STORAGE_KEY_ACTIVE_SESSION, JSON.stringify(appState.activeExam));
      } catch (err) {
        /* ignore quota errors */
      }
    }

    function checkSavedExamSessionBanner() {
      const banner = document.getElementById('saved-session-banner');
      const desc = document.getElementById('saved-session-desc');
      if (!banner || !desc) return;
      try {
        const raw = localStorage.getItem(STORAGE_KEY_ACTIVE_SESSION);
        if (!raw) {
          banner.classList.add('hidden');
          return;
        }
        const saved = JSON.parse(raw);
        if (saved && saved.studentName && saved.packageTitle) {
          banner.classList.remove('hidden');
          desc.textContent = `${saved.studentName} (${saved.studentClass}) • ${saved.packageTitle}`;
        } else {
          banner.classList.add('hidden');
        }
      } catch (err) {
        banner.classList.add('hidden');
      }
    }

    function resumeSavedExamSession() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_ACTIVE_SESSION);
        if (!raw) return;
        appState.activeExam = JSON.parse(raw);
        startExamWorkspace();
      } catch (err) {
        showToast('Gagal memulihkan sesi ujian tersimpan.', 'error');
      }
    }

    function discardSavedExamSession() {
      localStorage.removeItem(STORAGE_KEY_ACTIVE_SESSION);
      appState.activeExam = null;
