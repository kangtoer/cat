          <div id="q-stimulus-box" class="p-4 sm:p-5 rounded-2xl bg-slate-50 dark:bg-slate-800/70 border-l-4 border-emerald-600 text-slate-700 dark:text-slate-200 exam-font-md">
          </div>

          <!-- Question Stem -->
          <div id="q-stem-text" class="font-bold text-slate-900 dark:text-white exam-font-md">
          </div>

