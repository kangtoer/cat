    <!-- =====================================================================
         VIEW 2: ACTIVE CBT & CAT EXAM WORKSPACE
    ====================================================================== -->
    <section id="view-exam" class="hidden space-y-5">
      <!-- Top Exam Status Bar -->
      <div class="rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-4 shadow-sm flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <span id="exam-mode-badge" class="px-3 py-1 rounded-lg text-xs font-extrabold uppercase bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">CBT STANDAR</span>
          <div>
            <h2 id="exam-pkg-title" class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white">PSAS IPS</h2>
            <p id="exam-student-meta" class="text-xs text-slate-500 dark:text-slate-400">Peserta • Kelas</p>
          </div>
        </div>

        <!-- CAT Theta Ability Meter (Shown only in CAT mode) -->
        <div id="cat-theta-panel" class="hidden items-center gap-3 px-3.5 py-2 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800">
          <div>
            <div class="text-[10px] font-bold uppercase text-amber-700 dark:text-amber-400">Estimasi Kemampuan (θ)</div>
            <div class="flex items-center gap-2">
