    function loadSubmissions() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY_SUBMISSIONS);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed) && parsed.length > 0) {
            appState.submissions = parsed;
            return;
          }
        }
      } catch (e) {
        console.warn('Gagal membaca storage:', e);
      }
      appState.submissions = createSampleSubmissions();
      saveSubmissions();
    }

    function saveSubmissions() {
      try {
        localStorage.setItem(STORAGE_KEY_SUBMISSIONS, JSON.stringify(appState.submissions));
      } catch (e) {
        console.warn('Gagal menyimpan submissions:', e);
      }
    }

