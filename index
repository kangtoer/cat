    ===================================================================== */
    let toastTimer = null;

    function hideToast() {
      const el = document.getElementById('toast-banner');
      if (!el) return;
      if (toastTimer) {
        clearTimeout(toastTimer);
        toastTimer = null;
      }
      el.classList.remove('toast-visible');
      el.style.display = 'none';
      el.style.opacity = '0';
      el.style.pointerEvents = 'none';
    }

    function showToast(message, type = 'success') {
      const el = document.getElementById('toast-banner');
      const msgEl = document.getElementById('toast-message');
      const iconEl = document.getElementById('toast-icon');
      if (!el || !msgEl || !iconEl) return;

      if (toastTimer) {
        clearTimeout(toastTimer);
        toastTimer = null;
      }

      const palette = {
        success: { bg: 'bg-emerald-700 border-emerald-500/50', icon: '✓' },
        info: { bg: 'bg-navy-900 border-blue-500/50', icon: 'ℹ' },
        warning: { bg: 'bg-amber-600 border-amber-400/50', icon: '!' },
        error: { bg: 'bg-rose-700 border-rose-500/50', icon: '✕' }
      };
      const chosen = palette[type] || palette.success;

      el.className = `fixed bottom-5 right-5 z-50 max-w-md items-center gap-3 px-4 py-3.5 rounded-2xl text-white shadow-2xl border ${chosen.bg}`;
      iconEl.textContent = chosen.icon;
      msgEl.textContent = message;

      el.style.display = 'flex';
      el.style.pointerEvents = 'auto';
      requestAnimationFrame(() => {
        el.classList.add('toast-visible');
        el.style.opacity = '1';
      });

      toastTimer = setTimeout(() => {
        hideToast();
      }, 3000);
    }

