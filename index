        <div class="flex flex-wrap items-center gap-2.5">
          <div class="flex items-center bg-slate-100 dark:bg-slate-800 rounded-xl p-1 text-xs font-bold">
            <button onclick="setExamFont('sm')" class="px-2 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700">A-</button>
            <button onclick="setExamFont('md')" class="px-2 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700">A</button>
            <button onclick="setExamFont('lg')" class="px-2 py-1 rounded-lg hover:bg-white dark:hover:bg-slate-700">A+</button>
          </div>

          <div id="tab-warning-pill" class="px-3 py-1.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-xs font-semibold text-slate-600 dark:text-slate-300">
            Pindah Tab: <span id="tab-violation-count" class="font-mono font-bold text-rose-600">0</span>
          </div>

          <div class="px-3.5 py-1.5 rounded-xl bg-navy-900 text-white font-mono font-bold text-sm flex items-center gap-2 shadow-inner">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="exam-timer-display">90:00</span>
          </div>
        </div>
      </div>

      <!-- Main Exam Split Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        <!-- Question Stimulus & Answer Panel -->
        <div class="lg:col-span-8 rounded-3xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 p-5 sm:p-7 shadow-sm space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-100 dark:border-slate-800">
            <div class="flex items-center gap-2">
              <span id="q-number-badge" class="px-3 py-1 rounded-xl bg-navy-900 dark:bg-emerald-600 text-white font-extrabold text-sm">Soal No. 1</span>
