    /* =====================================================================
       4. EPHEMERAL TOAST NOTIFICATION SYSTEM (AUTO-DISMISS 2.8s, NEVER STUCK)
    ===================================================================== */
    function showToast(message, type = 'info') {
      document.querySelectorAll('.ephemeral-toast').forEach(el => el.remove());

      const palette = {
        success: 'bg-emerald-600 text-white border-emerald-400/40',
        error: 'bg-rose-600 text-white border-rose-400/40',
        warning: 'bg-amber-500 text-slate-950 border-amber-300/60',
        info: 'bg-slate-900 text-white border-slate-700'
      };

      const toast = document.createElement('div');
      toast.className = `ephemeral-toast fixed bottom-5 right-5 z-50 max-w-sm px-4 py-3 rounded-2xl border shadow-2xl flex items-center gap-3 text-xs sm:text-sm font-bold transition-all duration-200 ${palette[type] || palette.info}`;
      toast.innerHTML = `
        <span class="flex-1 leading-snug">${escapeHtml(message)}</span>
        <button type="button" aria-label="Tutup" class="px-1.5 py-0.5 rounded-lg bg-black/15 hover:bg-black/25 text-xs font-extrabold">✕</button>
      `;

      const closeBtn = toast.querySelector('button');
      if (closeBtn) closeBtn.addEventListener('click', () => toast.remove());

      document.body.appendChild(toast);
      setTimeout(() => {
        if (toast && toast.parentNode) toast.remove();
      }, 2800);
    }

    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

