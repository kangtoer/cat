    function importSubmissionFromRawString(rawText) {
      try {
        const parsed = JSON.parse(rawText);
        if (!parsed || !parsed.studentName || !parsed.packageId) {
          throw new Error('Format tidak valid');
        }
        if (!parsed.id) parsed.id = 'SUB-' + Date.now();
        const existsIdx = appState.submissions.findIndex(s => s.id === parsed.id);
        if (existsIdx >= 0) appState.submissions[existsIdx] = parsed;
        else appState.submissions.unshift(parsed);

        saveSubmissionsToStorage();
        appState.selectedSubmissionId = parsed.id;
        closeModal('modal-import');
        if (appState.currentView === 'proctor') renderProctorPortal();
        if (appState.currentView === 'teacher') renderTeacherPortal();
        showToast(`Hasil ujian milik ${parsed.studentName} berhasil diimpor!`, 'success');
      } catch (err) {
        showToast('Format token/JSON hasil tidak valid. Pastikan salinan lengkap.', 'error');
